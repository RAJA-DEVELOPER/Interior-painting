/* ============================================================
   RENOVA — Visual Polish: Images & Layout
   Fixes stretched images, inconsistent aspect ratios, jagged grids,
   hero cropping, avatar alignment and responsive layout gaps.
   Load AFTER section-align.css
   ============================================================ */

/* ── 0 · Base image hygiene ───────────────────────────────── */
img {
  display: block;
  max-width: 100%;
  height: auto;
  object-fit: cover;
  object-position: center center;
  -webkit-font-smoothing: antialiased;
}
img[width][height] { height: auto; } /* allow aspect-ratio */

/* Ensure any image inside a card/container fills its box */
.service-card__img img,
.blog-card__img img,
.project-card img,
.team-card__img-wrap img,
.featured-article__img img,
.dual-service-card img,
.color-preview-room img,
.ba-before img, .ba-after img,
.cta-section__bg img,
.slider__slide img,
.hero__bg img,
.about-hero__bg img,
.services-hero__bg img,
.article-hero__img,
.split-hero__right img,
.sitemap-group img,
.popular-post__img img,
.testimonial-card__avatar,
.featured-article__body img,
.article-content img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center center !important;
}

/* ── 1 · Hero images — perfect cover, no stretch ─────────── */
.hero-slider,
.about-hero,
.services-hero,
.blog-masthead,
.article-hero,
.contact-hero,
.sitemap-hero,
.legal-hero,
.split-hero {
  overflow: hidden !important;
  isolation: isolate;
}
.hero-slider .slider__slide img,
.about-hero__bg img,
.services-hero__bg img,
.article-hero__img,
.split-hero__right img,
.blog-masthead::before,
.sitemap-hero::before {
  object-fit: cover !important;
  object-position: center 35% !important; /* slightly elevated focal point */
}
.slider__overlay,
.about-hero__overlay,
.article-hero__overlay {
  background: linear-gradient(180deg, rgba(32,33,36,0.12) 0%, rgba(32,33,36,0.55) 55%, rgba(32,33,36,0.92) 100%) !important;
}

/* Hero slider — ensure slides are flex centered and not overlapping */
.hero-slider .slider__slides,
.hero-slider .slider__slide {
  width: 100% !important;
  height: 100% !important;
}
.hero-slider .slider__content {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: var(--nav-h) var(--gutter) var(--sp-12) !important;
}

/* ── 2 · Service cards — strict 4:3, rounded top, equal height ─ */
.service-card {
  overflow: hidden !important;
  border-radius: var(--r-lg) !important;
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
}
.service-card__img {
  aspect-ratio: 4 / 3 !important;
  width: 100% !important;
  overflow: hidden !important;
  background: var(--bg-muted) !important;
  position: relative;
  flex-shrink: 0;
}
.service-card__img img {
  transition: transform 0.7s var(--ease-out) !important;
}
.service-card:hover .service-card__img img { transform: scale(1.06) !important; }
.service-card__body {
  flex: 1 !important;
  display: flex !important;
  flex-direction: column !important;
  padding: var(--sp-7) var(--sp-6) !important;
}
.service-card__desc { flex: 1 !important; }

/* ── 3 · Story images (About) — refined overlapping, responsive ─ */
.story-split {
  align-items: center !important;
}
.story-img-stack {
  position: relative !important;
  width: 100% !important;
  max-width: 520px !important;
  margin-inline: auto !important;
  aspect-ratio: 4 / 3.4 !important;
  height: auto !important;
  min-height: 480px !important;
}
.story-img-main {
  position: absolute !important;
  width: 74% !important;
  height: 82% !important;
  right: 0 !important;
  top: 0 !important;
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
  box-shadow: var(--sh-lg) !important;
}
.story-img-accent {
  position: absolute !important;
  width: 52% !important;
  height: 48% !important;
  left: 0 !important;
  bottom: 0 !important;
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
  border: 6px solid var(--bg) !important;
  box-shadow: var(--sh-xl) !important;
  z-index: 1;
}
@media (max-width: 768px) {
  .story-img-stack { min-height: 360px !important; aspect-ratio: 4 / 2.8 !important; }
  .story-img-main { width: 78% !important; height: 78% !important; }
  .story-img-accent { width: 54% !important; height: 52% !important; }
}
@media (max-width: 480px) {
  .story-img-stack { min-height: 300px !important; }
  .story-img-accent { border-width: 4px !important; }
}

/* ── 4 · Before/After — crisp 16:9, centered, handle visible ─ */
.ba-wrap {
  aspect-ratio: 16 / 9 !important;
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
  box-shadow: var(--sh-xl) !important;
  background: var(--bg-muted) !important;
}
.ba-before, .ba-after { inset: 0 !important; }
.ba-divider { background: #fff !important; width: 2px !important; box-shadow: 0 0 12px rgba(0,0,0,0.35) !important; }
.ba-handle { width: 48px !important; height: 48px !important; background: #fff !important; box-shadow: 0 4px 20px rgba(0,0,0,0.28) !important; pointer-events: auto !important; cursor: col-resize !important; touch-action: none !important; }
.ba-label { font-size: var(--fs-11) !important; padding: 6px 14px !important; backdrop-filter: blur(8px) !important; }
@media (max-width: 768px) { .ba-wrap { aspect-ratio: 4 / 3 !important; border-radius: var(--r-lg) !important; } }

/* ── 5 · Stats, CTA bg — ensure cover ─────────────────────── */
.cta-section__bg {
  inset: 0 !important;
  opacity: 0.28 !important;
}
.cta-section__bg img { object-position: center 40% !important; }

/* ── 6 · Testimonial avatars — perfect circle, centered face ─ */
.testimonial-card__avatar,
.popular-post__img img,
.article-hero__content img[alt*="Ananya"],
.article-toc img {
  object-fit: cover !important;
  object-position: center top !important;
}
.testimonial-card__avatar {
  width: 52px !important;
  height: 52px !important;
  border-radius: 50% !important;
  flex-shrink: 0 !important;
  border: 2px solid var(--bg) !important;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08) !important;
}
.popular-post__img {
  width: 70px !important;
  height: 70px !important;
  border-radius: var(--r-md) !important;
  overflow: hidden !important;
  flex-shrink: 0 !important;
  background: var(--bg-muted) !important;
}
.testimonial-card__quote { line-height: 1 !important; overflow: hidden !important; }

/* Ensure testimonial cards equal height in grid */
.testimonial-grid .testimonial-card {
  min-height: 280px !important;
}

/* ── 7 · Team cards — 3:4 portrait, premium aligned ───── */
.team-section {
  background: #FDFBF7 !important;
  position: relative;
  isolation: isolate;
}
.team-section::before {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
}
.team-section .container { position: relative; z-index: 1; }
.team-grid {
  align-items: stretch !important;
  gap: 28px !important;
  grid-auto-rows: 1fr !important;
}
.team-card {
  background: #FFFFFF !important;
  border: 1px solid rgba(32,33,36,0.07) !important;
  border-radius: 24px !important;
  padding: 12px 12px 20px !important;
  height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  text-align: center !important;
  box-shadow: 0 4px 20px rgba(32,33,36,0.04), 0 1px 3px rgba(32,33,36,0.03) !important;
  transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out) !important;
}
.team-card:hover {
  transform: translateY(-6px) !important;
  box-shadow: 0 16px 40px rgba(32,33,36,0.08), 0 4px 12px rgba(32,33,36,0.05) !important;
}
.team-card__img-wrap {
  aspect-ratio: 4 / 5 !important;
  border-radius: 16px !important;
  overflow: hidden !important;
  background: var(--bg-muted) !important;
  width: 100% !important;
  margin-bottom: 16px !important;
  flex-shrink: 0 !important;
  position: relative;
}
.team-card__img-wrap::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.6);
  pointer-events: none;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
}
.team-card__img-wrap img {
  object-position: center top !important;
  object-fit: cover !important;
  width: 100% !important;
  height: 100% !important;
  transition: transform 0.7s var(--ease-out) !important;
}
.team-card:hover .team-card__img-wrap img { transform: scale(1.06) !important; }
.team-card__overlay {
  background: linear-gradient(to top, rgba(32,33,36,0.78) 0%, transparent 62%) !important;
  border-radius: 16px !important;
}
.team-card__name {
  font-size: 19px !important;
  font-weight: 500 !important;
  letter-spacing: -0.01em !important;
  margin-bottom: 4px !important;
  line-height: 1.25 !important;
}
.team-card__role {
  font-size: 11px !important;
  letter-spacing: 0.14em !important;
  font-weight: 700 !important;
}
.team-card__socials { justify-content: center !important; }
@media (max-width: 640px) {
  .team-card { padding: 10px 10px 18px !important; border-radius: 20px !important; }
  .team-card__img-wrap { border-radius: 14px !important; }
}

/* ── 7b · Home2 Keele Section — Proof Lux (Social Proof + Newsletter) Premium ─ */
