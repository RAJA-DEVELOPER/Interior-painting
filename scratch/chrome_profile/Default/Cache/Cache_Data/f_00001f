  font-size: 12px !important;
  color: var(--tx-3) !important;
  margin-bottom: 12px !important;
  font-weight: 500 !important;
  min-height: 18px !important;
}
.blog-card__meta span:nth-child(2) { opacity: 0.4; }
.blog-card__excerpt {
  font-size: 14px !important;
  color: var(--tx-3) !important;
  line-height: 1.65 !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
  flex: 1 !important;
  margin-bottom: 16px !important;
  min-height: 46px !important;
}
.articles-grid {
  align-items: start !important;
  align-content: start !important;
  gap: 20px !important;
  grid-auto-rows: auto !important;
  justify-items: stretch !important;
}
.blog-card__link {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 6px !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
  color: var(--tx-1) !important;
  background: var(--bg-alt) !important;
  border: 1px solid var(--bd) !important;
  padding: 9px 16px !important;
  border-radius: 999px !important;
  align-self: flex-start !important;
  margin-top: auto !important;
  transition: all 0.25s var(--ease-out) !important;
}
.blog-card:hover .blog-card__link {
  background: var(--ac) !important;
  border-color: var(--ac) !important;
  color: #fff !important;
  gap: 8px !important;
}
.blog-card__body { background: #fff !important; }

/* Spotlight — fix uneven heights */
.spotlight-grid {
  align-items: stretch !important;
}
.spotlight-grid > article:first-child {
  min-height: 480px !important;
  border-radius: var(--r-2xl) !important;
  overflow: hidden !important;
  position: relative !important;
  display: flex !important;
  align-items: flex-end !important;
  background: var(--bg-dark) !important;
}
.spotlight-grid > article:first-child img {
  position: absolute !important;
  inset: 0 !important;
  opacity: 0.52 !important;
}
.spotlight-grid > div {
  display: flex !important;
  flex-direction: column !important;
  gap: var(--col-gap) !important;
}
.spotlight-grid > div > article {
  flex: 1 !important;
  display: flex !important;
  flex-direction: column !important;
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
  background: var(--bg-card) !important;
  border: 1px solid var(--bd) !important;
}
.spotlight-grid > div > article img {
  height: 180px !important;
  width: 100% !important;
  object-fit: cover !important;
  flex-shrink: 0;
}
.spotlight-grid > div > article > div:last-child { flex: 1 !important; }

/* Popular posts sidebar */
.popular-post { align-items: center !important; }

/* ── 10 · Projects — CONSISTENT SIZE (Home-2 Portfolio) ─ */
.projects-grid {
  align-items: stretch !important;
  grid-auto-rows: 1fr !important;
  gap: var(--col-gap) !important;
}
.project-card,
.project-card-lg {
  aspect-ratio: 4 / 3 !important;
  border-radius: var(--r-lg) !important;
  overflow: hidden !important;
  background: var(--bg-muted) !important;
  position: relative !important;
  grid-column: span 1 !important; /* uniform — no featured double width */
  min-height: 0 !important;
  height: auto !important;
  display: block !important;
}
.project-card img,
.project-card-lg img {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
}
.project-card__overlay {
  opacity: 0 !important;
  transition: opacity 0.4s var(--ease-out) !important;
  background: linear-gradient(to top, rgba(32,33,36,0.92) 0%, rgba(32,33,36,0.18) 62%, transparent 100%) !important;
  padding: var(--sp-6) !important;
}
.project-card:hover .project-card__overlay,
.project-card-lg:hover .project-card__overlay { opacity: 1 !important; }
.project-card:hover img,
.project-card-lg:hover img { transform: scale(1.06) !important; }
@media (max-width: 1100px) {
  .projects-grid { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 640px) {
  .projects-grid { grid-template-columns: 1fr !important; }
  .project-card,
  .project-card-lg { aspect-ratio: 4 / 3 !important; }
}

/* ── 11 · Color preview & swatches ────────────────────────── */
.color-preview-room {
  aspect-ratio: 4 / 3 !important;
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
  background: var(--bg-muted) !important;
}
.swatch {
  width: 52px !important;
  height: 52px !important;
  border-radius: var(--r-md) !important;
  border: 3px solid transparent !important;
  flex-shrink: 0;
}
.swatch.active { border-color: var(--tx-1) !important; transform: scale(1.12) !important; }

/* ── 12 · Contact — map, info cards, social grid ─────────── */
.map-embed {
  height: 380px !important;
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
  border: 1px solid var(--bd) !important;
  background: var(--bg-muted) !important;
}
.map-embed iframe { width: 100% !important; height: 100% !important; border: 0 !important; }
.contact-info-card {
  border-radius: var(--r-xl) !important;
  align-items: flex-start !important;
  text-align: left !important;
}
.social-grid > a {
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  text-align: center !important;
  min-height: 180px !important;
  justify-content: center !important;
}
.social-grid > a svg { flex-shrink: 0; }

/* ── 13 · Article content images — centered, rounded, shadow ─ */
.article-content img {
  border-radius: var(--r-xl) !important;
  max-width: 100% !important;
  height: auto !important;
  aspect-ratio: auto !important;
  object-fit: cover !important;
  margin-block: var(--sp-8) !important;
  box-shadow: var(--sh-md) !important;
}
.article-content figcaption {
  text-align: center !important;
  font-size: var(--fs-13) !important;
  color: var(--tx-3) !important;
  margin-top: calc(-1 * var(--sp-4)) !important;
  margin-bottom: var(--sp-8) !important;
}

/* ── 14 · Logos & marks — crisp, no stretch ───────────────── */
.nav-logo__mark,
.footer__brand-mark {
  flex-shrink: 0 !important;
  background: transparent !important;
  border-radius: 9px !important;
  overflow: hidden !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}
.nav-logo__mark img,
.footer__brand-mark img {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain !important; /* logos should not be cropped */
  object-position: center !important;
}

/* ── 15 · General layout polish — gaps, dividers, cards ───── */
.section .container > *:first-child { margin-top: 0 !important; }
.pricing-card,
.value-card,
.award-item {
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
}
.value-card { padding: var(--sp-7) !important; min-height: 200px !important; }
.award-item { padding: var(--sp-6) var(--sp-4) !important; min-height: 180px !important; }
.pricing-card { padding: var(--sp-8) !important; }

.consultation-banner {
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
}
.sitemap-group,
.legal-nav {
  border-radius: var(--r-xl) !important;
  overflow: hidden !important;
}

/* ── 16 · Responsive image scaling ────────────────────────── */
@media (max-width: 1024px) {
  .featured-article__img { min-height: 300px !important; }
  .color-preview-room { aspect-ratio: 16 / 10 !important; }
}
@media (max-width: 768px) {
  .service-card__img { aspect-ratio: 16 / 10 !important; }
  .blog-card__img { aspect-ratio: 16 / 9 !important; }
  .project-card { aspect-ratio: 4 / 3 !important; }
  .team-card__img-wrap { aspect-ratio: 4 / 5 !important; }
  .map-embed { height: 300px !important; }
  .spotlight-grid > article:first-child { min-height: 380px !important; }
  .cta-section__bg { opacity: 0.22 !important; }
}
@media (max-width: 480px) {
  .service-card__img,
  .blog-card__img,
  .project-card { aspect-ratio: 16 / 10 !important; }
  .story-img-stack { aspect-ratio: auto !important; min-height: 320px !important; }
  .featured-article__img { min-height: 220px !important; }
  .testimonial-card__avatar { width: 48px !important; height: 48px !important; }
}

/* ── 17 · Prevent image CLS & overflow ────────────────────── */
.service-card, .project-card, .team-card,
.featured-article, .dual-service-card, .sitemap-group {
  contain: layout style;
}
.blog-card {
  contain: style;
}
img[loading="lazy"] { background: var(--bg-muted) !important; }
img.loaded { animation: imgFadeIn 0.4s var(--ease-out) !important; }

/* ── 18 · Layout grid consistency — ensure equal rows ─────── */
.services-grid,
.team-grid {
  grid-auto-rows: 1fr !important;
}
.values-grid,
.awards-grid,
.pricing-grid,
.topics-grid,
.sitemap-grid {
  grid-auto-rows: auto !important;
}
.articles-grid {
  grid-auto-rows: auto !important;
  align-items: start !important;
}

/* Ensure all cards in a row stretch to same height */
.grid-auto-equal > * { height: 100% !important; }

/* ── 19 · Fix hero-center split-hero image height on mobile ─ */
@media (max-width: 768px) {
  .split-hero { grid-template-columns: 1fr !important; }
  .split-hero__right { height: 52vh !important; min-height: 360px !important; }
  .split-hero__left { padding: calc(var(--nav-h) + var(--sp-8)) var(--gutter) var(--sp-10) !important; }
}

/* ── 20 · Footer & newsletter inputs — aligned ────────────── */
.footer__brand-mark img,
.nav-logo__mark img { object-fit: contain !important; }
.footer__newsletter { align-items: center !important; }

/* ── 21 · Card nalla align — equal height, baseline, no jank ─ */
.services-grid,
.blog-grid,
.projects-grid,
.testimonial-grid,
.team-grid,
.pricing-grid,
.values-grid,
.awards-grid,
.articles-grid,
.topics-grid {
  align-items: stretch !important;
  align-content: start !important;
}
.service-card,
.blog-card,
.testimonial-card,
.project-card,
.pricing-card,
.value-card,
.award-item,
.topic-card,
.sitemap-group,
.dual-service-card,
.spotlight-card-mini,
.featured-article {
  height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
}
.service-card__body,
.blog-card__body,
.testimonial-card,
.pricing-card,
.value-card,
.award-item {
  flex: 1 !important;
}
.service-card__body,
.blog-card__body,
.dual-service-body,
.spotlight-card-mini__body,
.featured-article__body {
  display: flex !important;
  flex-direction: column !important;
  flex: 1 !important;
}
.service-card__desc,
.blog-card__excerpt,
.testimonial-card__text,
.pricing-features,
.value-desc {
  flex: 1 !important;
}
.service-card__link,
.blog-card__link,
.testimonial-card__author,
.pricing-card .btn,
.dual-service-body .btn,
.topic-card {
  margin-top: auto !important;
}
.service-card__title,
.blog-card__title,
.testimonial-card__text,
.team-card__name,
.pricing-title,
.value-title,
.award-title {
  text-wrap: balance !important;
  overflow-wrap: break-word !important;
}
.service-card__title { min-height: auto !important; }
.blog-card__title { min-height: auto !important; }
.testimonial-card__text { min-height: auto !important; flex: 0 1 auto !important; }
.testimonial-track {
  align-items: stretch !important;
}
.testimonial-slider .testimonial-card {
  min-height: auto !important;
  height: auto !important;
  justify-content: flex-start !important;
}
/* Remove double gap causing mis-align in slider */
.testimonial-slider .testimonial-card { margin-right: 0 !important; }
/* Grid gaps consistent */
.services-grid,
.blog-grid,
.projects-grid { gap: var(--col-gap) !important; }

/* Ensure images never stretch cards */
.service-card__img,
.blog-card__img,
.project-card,
.team-card__img-wrap,
.testimonial-card__avatar {
  flex-shrink: 0 !important;
}

/* Center-align card footers / authors baseline */
.testimonial-card__author {
  align-items: center !important;
  padding-top: var(--sp-4) !important;
  border-top: 1px solid transparent !important;
}
.team-card { text-align: center !important; align-items: center !important; }
.team-card__name { text-align: center !important; width: 100% !important; }

/* ── 22 · WCAG Contrast Fixes — Light & Dark ── */
.eyebrow { color: var(--ac-h) !important; }
.blog-card__cat,
.highlight-cat,
.topic-card__count { color: var(--ac-h) !important; }
.sec-subtitle,
.value-desc,
.award-org,
.footer__tagline,
.footer__copy,
.form-note,
.newsletter-disclaimer,
.cta-disclaimer { color: var(--tx-3) !important; }
.footer__copy,
.footer__legal-link,
.footer__tagline { opacity: 1 !important; color: rgba(255,255,255,0.72) !important; }
[data-theme="dark"] .footer__copy,
[data-theme="dark"] .footer__legal-link,
[data-theme="dark"] .footer__tagline { color: rgba(255,255,255,0.72) !important; }
.footer__legal-link:hover { color: #fff !important; }
.bg-dark .sec-subtitle { color: rgba(255,255,255,0.72) !important; }
.bg-dark .stat-label { color: rgba(255,255,255,0.58) !important; }
.proof-badge__label,
.masthead-stat-box__desc,
.contact-info-sub { color: rgba(255,255,255,0.62) !important; }
.blog-card__meta,
.popular-post__date,
.comment-time,
.award-year { color: var(--tx-3) !important; }
.btn-ghost { color: #fff !important; border-color: rgba(255,255,255,0.28) !important; }
[data-theme="dark"] .btn-ghost { color: var(--tx-1) !important; }
.form-input::placeholder,
.form-textarea::placeholder { color: var(--tx-3) !important; opacity: 0.85 !important; }
[data-theme="dark"] .form-input,
[data-theme="dark"] .form-select,
[data-theme="dark"] .form-textarea { color: var(--tx-1) !important; border-color: rgba(237,232,224,0.14) !important; }
